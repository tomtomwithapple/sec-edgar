# Copy to .env and fill in. Real environment variables win over .env.

# Required for SEC EDGAR jobs: "Name email@example.com" (SEC fair-access policy).
SEC_USER_AGENT=
# Optional: BLS v2 key (without it the keyless v1 API is used).
BLS_API_KEY=
# Required for www.bls.gov (the BLS release calendar): a contact email. bls.gov answers 403
# unless the User-Agent carries one; usfin sends "usfin/<version> (<email>)".
BLS_CONTACT_EMAIL=
# Needed only for `usfin bls alfred-backfill`.
FRED_API_KEY=
# Required for the Alpaca market data jobs (free paper account: https://app.alpaca.markets ->
# API keys). Sent as headers to data.alpaca.markets / paper-api.alpaca.markets only.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: alerts are POSTed here as JSON.
ALERT_WEBHOOK_URL=

# Paths (defaults shown).
USFIN_DB=data/usfin.duckdb
USFIN_RAW=raw
USFIN_CONFIG=config
# Seconds a job or write command waits for the DuckDB lock.
USFIN_LOCK_WAIT=600
# Free-disk floor (GiB) on the raw and DB volumes: an EDGAR bulk download or load that would
# leave less does not start (and a load stops when it is crossed).
USFIN_MIN_FREE_GB=10
# Optional: job edgar_bulk (weekly reconcile) parses at most this many changed members per
# bulk ZIP (unset = all of them).
USFIN_BULK_LIMIT=
